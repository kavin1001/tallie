# Default deny: only the build's explicit source inputs enter the context.
*
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
!apps/**
!packages/
!packages/**
!scripts/
!scripts/**
!Dockerfile
!.dockerignore

**/node_modules
**/.next
**/dist
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
**/.tallie
**/.git
**/.DS_Store
**/*.log
**/*.pem
**/*.key
**/*credentials*.json
**/AGENTS.md
packages/**/fixtures
**/*.test.ts
scripts/verify-*.ts
scripts/setup-local.mjs
