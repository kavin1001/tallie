# Local real-account app plus a separate synthetic /demo. Use beta when hosting.
APP_MODE=demo
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tallie:tallie_local_only@127.0.0.1:55434/tallie

# Optional live receipt interpretation, separate from simulated payments.
# Setting this key enables receipt capture locally unless RECEIPTS_ENABLED=false.
OPENAI_API_KEY=
RECEIPT_MODEL=gpt-4.1-mini-2025-04-14
# RECEIPTS_ENABLED=false
# RECEIPT_STORAGE_DIR=/absolute/private/path (defaults to .tallie/receipts)

# Phone signup and optional iMessage agent. These never enable payments.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=
SENDBLUE_VERIFY_SERVICE_SID=
# Generate independently: 32 random bytes encoded as 64 hexadecimal characters.
SENDBLUE_PHONE_ENCRYPTION_KEY=

# npm run setup generates missing local secrets; use separate hosted secrets.
BETTER_AUTH_SECRET=
IDENTITY_ENCRYPTION_KEY=
MESSAGING_ENCRYPTION_KEY=
SENDBLUE_MESSAGE_WEBHOOK_SECRET=
# Enable only after HTTPS webhook, messaging line and consenting-device checks.
MESSAGING_SEND_ENABLED=false

# Optional phone-only demo sign-in, accepted only by the web-preview launcher.
# Keep disabled in ordinary environments; preview accounts cannot move money.
IDENTITY_PHONE_DEMO_ENABLED=false

# Natural test accounts. Off by default; real payments remain disabled.
# Never paste keys into chat. Configure these only in server-side secrets.
NATURAL_SANDBOX_ENABLED=false
NATURAL_ENVIRONMENT=sandbox
# Party/admin sandbox key; NATURAL_PROVISIONING_API_KEY is an explicit alias.
NATURAL_API_KEY=
# Separate sandbox agent credential and its confirmed owning agent/platform party.
NATURAL_AGENT_KEY=
NATURAL_AGENT_ID=
NATURAL_PLATFORM_PARTY_ID=

# Hosted web server: APP_HOST=0.0.0.0 (local defaults to 127.0.0.1).
# Use one private S3 bucket for separately deployed web/receipt/message processes.
# RECEIPT_STORAGE_DRIVER=s3
# RECEIPTS_BUCKET=
# RECEIPTS_BUCKET_OWNER=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
